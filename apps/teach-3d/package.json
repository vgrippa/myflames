{
  "name": "myflames-teach-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D views of the myflames teach lessons, built into one offline HTML file per lesson.",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/assemble.mjs",
    "test": "node --test test/model.test.mjs",
    "test:smoke": "npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "puppeteer": "24.42.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
