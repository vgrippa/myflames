{
  "name": "myflames-desktop",
  "productName": "myflames",
  "version": "3.3.3",
  "private": true,
  "description": "Local desktop launcher for the myflames workspace",
  "license": "Apache-2.0",
  "author": "Vinicius Grippa and the myflames contributors",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "build:backend": "python3 scripts/build-backend.py",
    "fetch:mysql-client": "python3 scripts/fetch-mysql-client.py",
    "package:dir": "electron-builder --dir --config electron-builder.json",
    "package:mac": "python3 scripts/fetch-mysql-client.py --platform darwin-arm64 && electron-builder --mac dir --arm64 --config electron-builder.json",
    "package:mac:release": "sh scripts/package-mac-release.sh",
    "package:win": "electron-builder --win --x64 --publish never --config electron-builder.json"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  }
}
