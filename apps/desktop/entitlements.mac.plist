<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT pages under the hardened runtime. Nothing else is granted:
         no camera, microphone, location or Apple Events, and library validation
         stays on because every bundled binary carries the same Team ID. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
