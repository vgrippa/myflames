{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgrippa/myflames/docs/schemas/parameter-snapshot-1.0.json",
  "title": "myflames parameter-snapshot-1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "parameter-snapshot-1.0"
    },
    "server": {
      "type": "object",
      "properties": {
        "engine": {
          "enum": [
            "mysql",
            "mariadb"
          ]
        },
        "flavor": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_product": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "server_version": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_id": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "host",
        "port",
        "engine"
      ],
      "additionalProperties": false
    },
    "captured_at": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "maxLength": 200
    },
    "complete": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parameter catalog read warnings only. Known legacy configuration counter and heuristic-status explanations are removed during validation."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_.]+$"
          },
          "type": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "apply_type": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_label": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "modifiable": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "group": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "values": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "dynamic": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "redacted": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "value",
          "default"
        ],
        "additionalProperties": false
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "server",
    "captured_at",
    "label",
    "complete",
    "notes",
    "items"
  ],
  "additionalProperties": false,
  "description": "Global parameter values and known metadata. Secret-bearing settings have redacted=true and [redacted] values/defaults. Raw display values are retained. Unknown defaults and metadata are null. Dynamic is derived from parameters-1.0 apply_type. No connection credentials are retained. Redaction uses an explicit secret-variable inventory and clear credential syntax in values, including password-bearing URLs and user:password pairs. A password-related policy, number or key-file path is not itself secret."
}
