{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgrippa/myflames/docs/schemas/parameter-snapshot-list-1.0.json",
  "title": "myflames parameter-snapshot-list-1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "parameter-snapshot-list-1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "saved_at": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "server": {
            "type": "object",
            "properties": {
              "engine": {
                "enum": [
                  "mysql",
                  "mariadb"
                ]
              },
              "flavor": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "server_product": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "server_version": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "profile_id": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "profile_name": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "required": [
              "host",
              "port",
              "engine"
            ],
            "additionalProperties": false
          },
          "captured_at": {
            "type": "string"
          },
          "complete": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "number",
          "saved_at",
          "source_key",
          "label",
          "server",
          "captured_at",
          "complete",
          "count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false
}
