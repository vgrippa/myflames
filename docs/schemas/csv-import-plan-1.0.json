{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgrippa/myflames/docs/schemas/csv-import-plan-1.0.json",
  "title": "myflames Import CSV plan (csv-import-plan-1.0)",
  "description": "The reviewed import: the target as the server describes it, the mapping, every row checked as it will be sent (counts and the first 100 problems), the exact CREATE TABLE when there is one, the first data statement, the method (INSERT batches, or LOAD DATA LOCAL from a checked copy only when the server has local_infile ON), the transaction mode, privileges from SHOW GRANTS (unknown never blocks), the connection's write policy (Production and Development both review; Read-only refuses), warnings and notes. target.triggers is null when the account cannot see the table's triggers (information_schema needs the TRIGGER privilege). method.client_limits_files says whether the client sends only files from myflames' folder of checked copies (MySQL clients with --load-data-local-dir) or any file the server asks for (MariaDB's client); null for INSERT. token is null unless ready; it binds the connection identity, the file's size, mtime and SHA-256, the format, target metadata, mapping, method, transaction and statements, expires after expires_in seconds and is used once.",
  "$defs": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "separator",
        "quote",
        "escape",
        "header",
        "line_ending",
        "skip_lines",
        "empty",
        "null_markers"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "utf-8",
            "utf-8-sig",
            "utf-16-le",
            "utf-16-be",
            "cp1252"
          ]
        },
        "separator": {
          "type": "string",
          "pattern": "^[^\\r\\n\\u0000]$"
        },
        "quote": {
          "enum": [
            "\"",
            "'",
            ""
          ]
        },
        "escape": {
          "enum": [
            "",
            "\\"
          ]
        },
        "header": {
          "type": "boolean"
        },
        "line_ending": {
          "enum": [
            "\n",
            "\r\n",
            "\r"
          ]
        },
        "skip_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "empty": {
          "enum": [
            "null",
            "empty"
          ]
        },
        "null_markers": {
          "type": "array",
          "items": {
            "enum": [
              "\\N",
              "NULL"
            ]
          },
          "maxItems": 2
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "column",
        "value",
        "message"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token",
    "ready",
    "blockers",
    "expires_in",
    "file",
    "format",
    "connection",
    "target",
    "mapping",
    "statements",
    "batches",
    "rows",
    "problems",
    "problems_total",
    "method",
    "transaction",
    "on_error",
    "privileges",
    "policy",
    "warnings",
    "notes",
    "drop_hint"
  ],
  "properties": {
    "schema_version": {
      "const": "csv-import-plan-1.0"
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_in": {
      "type": "integer",
      "minimum": 0
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "name",
        "size",
        "modified",
        "sha256"
      ],
      "properties": {
        "file_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "format": {
      "$ref": "#/$defs/format"
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host",
        "port",
        "user",
        "type",
        "read_only",
        "engine",
        "server_version",
        "server_product"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        },
        "user": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "enum": [
            "production",
            "development"
          ]
        },
        "read_only": {
          "type": "boolean"
        },
        "engine": {
          "enum": [
            "mysql",
            "mariadb"
          ]
        },
        "server_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_product": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "schema",
        "table",
        "exists",
        "engine",
        "transactional",
        "columns",
        "rows_estimate",
        "triggers",
        "foreign_keys",
        "check_constraints",
        "primary_key"
      ],
      "properties": {
        "mode": {
          "enum": [
            "existing",
            "new"
          ]
        },
        "schema": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "transactional": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "nullable",
              "default",
              "extra"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "nullable": {
                "type": "boolean"
              },
              "default": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "extra": {
                "type": "string"
              }
            }
          }
        },
        "rows_estimate": {
          "type": [
            "integer",
            "null"
          ]
        },
        "triggers": {
          "type": [
            "integer",
            "null"
          ]
        },
        "foreign_keys": {
          "type": "integer",
          "minimum": 0
        },
        "check_constraints": {
          "type": "integer",
          "minimum": 0
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "csv_index",
          "csv_header",
          "column",
          "type"
        ],
        "properties": {
          "csv_index": {
            "type": "integer",
            "minimum": 0
          },
          "csv_header": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "statements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "data_sample",
        "data_summary",
        "setup"
      ],
      "properties": {
        "create": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_sample": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_summary": {
          "type": "string"
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "batches": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "valid",
        "invalid",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      },
      "maxItems": 100
    },
    "problems_total": {
      "type": "integer",
      "minimum": 0
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chosen",
        "load_data_available",
        "local_infile",
        "why",
        "client_limits_files"
      ],
      "properties": {
        "chosen": {
          "enum": [
            "insert",
            "load_data"
          ]
        },
        "load_data_available": {
          "type": "boolean"
        },
        "local_infile": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "why": {
          "type": "string"
        },
        "client_limits_files": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "every",
        "commits"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all",
            "every"
          ]
        },
        "every": {
          "type": [
            "integer",
            "null"
          ]
        },
        "commits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "on_error": {
      "enum": [
        "stop",
        "skip"
      ]
    },
    "privileges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "state",
          "reason"
        ],
        "properties": {
          "action": {
            "enum": [
              "insert",
              "create_table"
            ]
          },
          "state": {
            "enum": [
              "allowed",
              "denied",
              "unknown"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "tone",
        "title",
        "text",
        "connection_type",
        "read_only"
      ],
      "properties": {
        "action": {
          "enum": [
            "allow",
            "confirm",
            "refuse"
          ]
        },
        "tone": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "connection_type": {
          "enum": [
            "production",
            "development"
          ]
        },
        "read_only": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "drop_hint": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
