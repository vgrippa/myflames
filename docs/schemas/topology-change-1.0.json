    "schema_version",
    "plan_id",
    "change_set_id",
    "group_name",
    "name",
    "value",
    "mode",
    "status",
    "message",
    "members",
    "audit_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "topology-change-1.0"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_set_id": {
      "type": [
