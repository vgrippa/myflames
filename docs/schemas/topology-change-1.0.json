        "profile_name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "status": {
          "enum": [
            "applied",
            "unchanged",
            "refused",
