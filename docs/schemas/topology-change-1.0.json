{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "change_set_id",
    "group_name",
    "name",
    "value",
    "mode",
    "status",
    "message",
    "members",
    "audit_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "topology-change-1.0"
    },
    "plan_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "group_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "global",
        "persist",
        "persist_only",
        null
      ]
    },
    "status": {
      "enum": [
        "applied",
        "partial",
        "refused",
        "stopped",
        "stale"
      ]
    },
    "message": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/member"
      }
    },
    "audit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Sequential member results. A stop never interrupts an already sent statement. Unknown effects require inspection before another review. Variable drift is reported separately from saved connection or group changes. Refusals during dependency, identity or variable rechecks mean no reviewed statement was sent to that member; an identity guard rejection is also unsent. Server error messages describe rejected writes only. Any selected member refused at plan time refuses the whole apply before login or writes; every result member is not_sent and refused members retain their reason.",
  "definitions": {
    "identity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "server_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostname": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "wsrep_node_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "wsrep_on": {
          "type": [
            "string",
            "null"
          ]
        },
        "wsrep_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "wsrep_gcomm_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "server_uid": {
          "type": [
            "string",
            "null"
          ],
          "description": "MariaDB MAC-and-port hash, bound with the full server identity and version."
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_name",
        "host",
        "port",
        "identity",
        "status",
        "statement",
        "before",
        "after",
        "effect",
        "caveats",
        "privileges",
        "config_line",
        "reason",
        "message",
        "audit_id",
        "duplicate_of",
        "effective_mode"
      ],
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "profile_name": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "identity": {
          "$ref": "#/definitions/identity"
        },
        "status": {
          "enum": [
            "applied",
            "unchanged",
            "refused",
            "not_sent",
            "unknown"
          ]
        },
        "statement": {
          "type": [
            "string",
            "null"
          ]
        },
        "before": {
          "type": [
            "object",
            "null"
          ]
        },
        "after": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "global": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "persisted": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "effect": {
          "type": [
            "object",
            "null"
          ],
          "description": "The variables effect object; render its text field."
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privileges": {
          "type": [
            "object",
            "null"
          ]
        },
        "config_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "audit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "duplicate_of": {
          "description": "Profile ID of the first selected member in rolling order with the same server identity; null otherwise. Later aliases are refused with no statement.",
          "type": [
            "string",
            "null"
          ]
        },
        "effective_mode": {
          "enum": [
            "global",
            "persist",
            "persist_only",
            null
          ],
          "description": "Scopes applied on this member; MariaDB persistence requests use global."
        }
      }
    }
  }
}
