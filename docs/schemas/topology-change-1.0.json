      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "global",
        "persist",
        "persist_only",
        null
      ]
    },
    "status": {
      "enum": [
        "applied",
        "partial",
        "refused",
        "stopped",
        "stale"
      ]
    },
    "message": {
      "type": "string"
