{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgrippa/myflames/docs/schemas/readyset-1.0.json",
  "title": "myflames Readyset report (readyset-1.0)",
  "description": "What the Readyset place, `myflames readyset --json`, POST /api/live/readyset and the MCP tool readyset_status (detail=full) read from a Readyset SQL (3307) or admin (6036) port: caches (deep and shallow), observed cached vs upstream execution latencies, proxied query support verdicts, base-table replication status and mode-aware lag, shallow cache allowlists, client connections, upstreams, and multi-tier ProxySQL + Readyset + MySQL/MariaDB topology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "available",
    "is_readyset",
    "version",
    "port_role",
    "in_readyset_schema",
    "readyset_schema",
    "message",
    "status",
    "status_why",
    "status_fields",
    "capabilities",
    "replication",
    "telemetry",
    "caches",
    "proxied_queries",
    "tables",
    "table_counts",
    "shallow_allowlists",
    "connections",
    "upstreams",
    "topology",
    "fingerprints",
    "actions",
    "notes",
    "statements"
  ],
  "properties": {
    "schema_version": { "const": "readyset-1.0" },
    "captured_at": { "type": "string" },
    "available": { "type": "boolean" },
    "is_readyset": { "type": "boolean" },
    "version": { "type": ["string", "null"] },
    "port_role": { "enum": ["adapter", "admin", null] },
    "in_readyset_schema": { "type": "boolean" },
    "readyset_schema": { "type": "string" },
    "message": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "watch", "problem", "unknown"] },
    "status_why": { "type": "array", "items": { "type": "string" } },
    "status_fields": { "type": "object" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_explain_cache",
        "can_create_cache",
        "can_manage_caches",
        "can_alter_readyset",
        "can_shutdown",
        "virtual_tables"
      ],
      "properties": {
        "can_explain_cache": { "type": "boolean" },
        "can_create_cache": { "type": "boolean" },
        "can_manage_caches": { "type": "boolean" },
        "can_alter_readyset": { "type": "boolean" },
        "can_shutdown": { "type": "boolean" },
        "virtual_tables": { "type": "boolean" }
      }
    },
    "replication": { "type": ["object", "null"] },
    "telemetry": { "type": "object" },
    "caches": { "type": "array", "items": { "type": "object" } },
    "proxied_queries": { "type": "array", "items": { "type": "object" } },
    "tables": { "type": "array", "items": { "type": "object" } },
    "table_counts": { "type": "object" },
    "shallow_allowlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functions", "variables", "schemas"],
      "properties": {
        "functions": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "connections": { "type": "array", "items": { "type": "object" } },
    "upstreams": { "type": "array", "items": { "type": "object" } },
    "topology": { "type": ["object", "null"] },
    "fingerprints": { "type": "object" },
    "actions": { "type": "array", "items": { "type": "object" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "statements": { "type": "array", "items": { "type": "string" } }
  }
}
