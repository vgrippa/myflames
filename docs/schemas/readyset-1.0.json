{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vgrippa/myflames/docs/schemas/readyset-1.0.json",
  "title": "myflames Readyset report (readyset-1.0)",
  "description": "What the Readyset place, `myflames readyset --json`, POST /api/live/readyset and the MCP tool readyset_status (detail=full) read from a Readyset SQL (3307) or admin (6036) port: caches (deep and shallow), observed cached vs upstream execution latencies, proxied query support verdicts, base-table replication status and mode-aware lag, shallow cache allowlists, client connections, upstreams, and multi-tier ProxySQL + Readyset + MySQL/MariaDB topology.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection_group",
    "schema_version",
    "captured_at",
    "available",
    "is_readyset",
    "version",
    "port_role",
    "in_readyset_schema",
    "readyset_schema",
    "session_database",
    "message",
    "status",
    "status_why",
    "findings",
    "status_fields",
    "capabilities",
    "replication",
    "telemetry",
    "caches",
    "proxied_queries",
    "tables",
    "table_counts",
    "shallow_allowlists",
    "allowlist_actions",
    "allowlist_item_actions",
    "connections",
    "upstreams",
    "topology",
    "fingerprints",
    "actions",
    "notes",
    "statements"
  ],
  "properties": {
    "connection_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "read",
        "suggestions",
        "join",
        "suggested_name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "read": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "outcome",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "production",
                  "development"
                ]
              },
              "outcome": {
                "enum": [
                  "read",
                  "failed",
                  "not_reached"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "address",
              "group",
              "evidence",
              "evidence_text"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "production",
                  "development"
                ]
              },
              "address": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "evidence": {
                "enum": [
                  "same_group_replication_group",
                  "same_innodb_cluster",
                  "same_clusterset",
                  "same_galera_cluster",
                  "replication_source",
                  "replica_of_this_server",
                  "same_server",
                  "address_named_by_this_server"
                ]
              },
              "evidence_text": {
                "type": "string"
              }
            }
          }
        },
        "join": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group",
              "evidence",
              "evidence_text"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "evidence": {
                "enum": [
                  "same_group_replication_group",
                  "same_innodb_cluster",
                  "same_clusterset",
                  "same_galera_cluster",
                  "replication_source",
                  "replica_of_this_server",
                  "same_server",
                  "address_named_by_this_server"
                ]
              },
              "evidence_text": {
                "type": "string"
              }
            }
          }
        },
        "suggested_name": {
          "type": "string"
        }
      }
    },
    "schema_version": { "const": "readyset-1.0" },
    "captured_at": { "type": "string" },
    "available": { "type": "boolean" },
    "is_readyset": { "type": "boolean" },
    "version": { "type": ["string", "null"] },
    "port_role": { "enum": ["adapter", "admin", null] },
    "in_readyset_schema": { "type": "boolean" },
    "readyset_schema": { "type": "string" },
    "session_database": {
      "type": ["string", "null"],
      "description": "The connection's default database exactly as given at read time (null when empty); the workspace treats a report whose session_database differs from the connection in use's database as stale."
    },
    "message": { "type": ["string", "null"] },
    "status": { "enum": ["ok", "watch", "problem", "unknown"] },
    "status_why": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "title", "text", "tab"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["watch", "problem"] },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "tab": { "enum": ["topology", "caches", "proxied", "tables", "parameters"] }
        }
      }
    },
    "status_fields": {
      "type": "object",
      "description": "Raw SHOW READYSET STATUS fields. status is null when the server did not report a Status row (never defaulted to Online); the other fields are null when not reported."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_explain_cache",
        "can_create_cache",
        "can_manage_caches",
        "can_alter_readyset",
        "can_shutdown",
        "virtual_tables"
      ],
      "properties": {
        "can_explain_cache": { "type": "boolean" },
        "can_create_cache": { "type": "boolean" },
        "can_manage_caches": { "type": "boolean" },
        "can_alter_readyset": { "type": "boolean" },
        "can_shutdown": { "type": "boolean" },
        "virtual_tables": { "type": "boolean" }
      }
    },
    "replication": { "type": ["object", "null"] },
    "telemetry": { "type": "object" },
    "caches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "description": "Row-scope action catalog (same entry shape as actions).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "scope": { "enum": ["server", "row"] },
                "tone": { "enum": ["default", "danger"] },
                "danger": { "type": "boolean" },
                "description": { "type": "string" },
                "enabled": { "type": "boolean" },
                "why_not": { "type": ["string", "null"] },
                "fix": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "proxied_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "description": "Row-scope action catalog (same entry shape as actions).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "scope": { "enum": ["server", "row"] },
                "tone": { "enum": ["default", "danger"] },
                "danger": { "type": "boolean" },
                "description": { "type": "string" },
                "enabled": { "type": "boolean" },
                "why_not": { "type": ["string", "null"] },
                "fix": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actions": {
            "type": "array",
            "description": "Row-scope action catalog (same entry shape as actions).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "scope": { "enum": ["server", "row"] },
                "tone": { "enum": ["default", "danger"] },
                "danger": { "type": "boolean" },
                "description": { "type": "string" },
                "enabled": { "type": "boolean" },
                "why_not": { "type": ["string", "null"] },
                "fix": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "table_counts": { "type": "object" },
    "shallow_allowlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functions", "variables", "schemas"],
      "properties": {
        "functions": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "allowlist_actions": {
      "type": "object",
      "description": "Row-scope action catalog per shallow allowlist kind (same entry shape as actions).",
      "additionalProperties": false,
      "required": ["functions", "variables", "schemas"],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        },
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "allowlist_item_actions": {
      "type": "object",
      "description": "Per-item drop_shallow_allowed entries, parallel to shallow_allowlists[kind] (same entry shape as actions): entry i is the removal eligibility of item i, so a name with control or format characters is disabled with its own reason while other items stay enabled.",
      "additionalProperties": false,
      "required": ["functions", "variables", "schemas"],
      "properties": {
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        },
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "scope": { "enum": ["server", "row"] },
              "tone": { "enum": ["default", "danger"] },
              "danger": { "type": "boolean" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean" },
              "why_not": { "type": ["string", "null"] },
              "fix": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "connections": { "type": "array", "items": { "type": "object" } },
    "upstreams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "active_cdc": {
            "type": ["boolean", "null"],
            "description": "Whether this is the active CDC upstream; null when Readyset did not report it."
          }
        }
      }
    },
    "topology": {
      "type": ["object", "null"],
      "description": "Multi-tier topology. this_server.status is null when SHOW READYSET STATUS did not report a Status row (never defaulted to Online). Upstream active_cdc is null when Readyset did not report it (its controller could not answer), never coerced to false; the CDC Server fallback upstream has null health because Database Connection is an aggregate any proxy upstream can satisfy, not host evidence. proxysql_nodes carry status_source and a null backend_status when the backend row came only from ProxySQL configuration."
    },
    "fingerprints": { "type": "object" },
    "actions": {
      "type": "array",
      "description": "Server-scope action catalog: every action always listed with enabled/why_not/fix; danger equals the pre-catalog tone \"danger\" set (tone kept for one release).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "scope", "tone", "danger", "description", "enabled", "why_not", "fix"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "scope": { "enum": ["server", "row"] },
          "tone": { "enum": ["default", "danger"] },
          "danger": { "type": "boolean" },
          "description": { "type": "string" },
          "enabled": { "type": "boolean" },
          "why_not": { "type": ["string", "null"] },
          "fix": { "type": ["string", "null"] }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "statements": { "type": "array", "items": { "type": "string" } }
  }
}
